// ── Terminals ──────────────────────────────────────────────
// NAME excludes reserved words (keyword reservation).
NAME      : /(?!(?:if|elseif|else|while|for|foreach|fn|return|local|const|true|false|null|and|or|not|in|break|continue|class|extends|new|static|public|private|this|super|constructor)\b)[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER    : /[0-9]+(\.[0-9]+)?/
STRING    : /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
COMMENT   : /\/\/[^\n]*/
// Matches a bare `return` at the end of a line (or before a comment/EOF).
// Higher priority so it wins over the `return` keyword on equal length.
RETURN_VOID.2 : /return[ \t]*(?=\/\/|\n|$)/

array: "[" [expr ("," expr)* [","]] "]"
bool: "true" -> bool_true
    | "false" -> bool_false

lambda_fn: "(" ")" block
         | "(" expr ("," expr)* ")" block -> lambda_fn_args

map_obj: expr ":" expr
map: "{" [map_obj ("," map_obj)* [","]] "}"

// ── Entry point ────────────────────────────────────────────
?start        : statement*

// ── Statements ─────────────────────────────────────────────
?statement    : local_decl
            | const_decl
            | class_def
            | fn_def
            | return_stmt
            | while_stmt
            | for_stmt
            | foritem_stmt
            | break_stmt
            | continue_stmt
            | member_assign
            | expr_stmt
            | decl
            | if_stmt

// ── Variable declaration ───────────────────────────────────
local_decl   : "local" NAME "=" expr
const_decl   : "const" NAME "=" expr
decl: NAME "=" expr

// Assignment to a member: `this.x = value`, `obj.x = value`
member_assign: postfix "." NAME "=" expr

// ── Class definition ───────────────────────────────────────
class_def     : "class" NAME class_body -> class_def_simple
              | "class" NAME "extends" NAME class_body -> class_def_extends

class_body    : "{" class_member* "}"

?class_member : field_decl
              | method_def
              | constructor_def

modifier      : "static"  -> mod_static
              | "public"  -> mod_public
              | "private" -> mod_private

field_decl    : modifier* NAME "=" expr

// Methods default to public when no visibility modifier is given.
method_def    : modifier* "fn" NAME "(" param_list ")" block -> method_def_args
              | modifier* "fn" NAME "(" ")" block -> method_def_nargs

constructor_def : modifier* "constructor" "(" param_list ")" block -> constructor_def_args
                | modifier* "constructor" "(" ")" block -> constructor_def_nargs

// ── Function definition ────────────────────────────────────
fn_def       : "fn" NAME "(" param_list ")" block
            | "fn" NAME "(" ")" block -> fn_def_nargs

param_list : NAME ("," NAME)*



// ── Return ─────────────────────────────────────────────────
return_stmt  : "return" expr? -> return_value
             | RETURN_VOID    -> return_void

// ── While ──────────────────────────────────────────────────
while_stmt   : "while" "(" expr ")" block

// ── Break / Continue ───────────────────────────────────────
break_stmt    : "break"
continue_stmt : "continue"

// ── For loops ──────────────────────────────────────────────
for_stmt     : "for" "(" NAME "in" expr ")" block
foritem_stmt : "foreach" "(" NAME "," NAME "in" expr ")" block

// ── If ─────────────────────────────────────────────────────

if_stmt: "if" "(" expr ")" block elseif_stmt* elsestmt?
elseif_stmt: "elseif" "(" expr ")" block
elsestmt: "else" block

// ── Block ──────────────────────────────────────────────────
block        : "{" statement* "}"

// ── Expressions ────────────────────────────────────────────
// Precedence, lowest to highest:
//   or  <  and  <  not  <  comparison  <  +/-  <  *//%  <  unary  <  postfix
?expr_stmt    : expr

?expr         : or_expr

?or_expr      : and_expr
              | or_expr "or" and_expr -> or_cond

?and_expr     : not_expr
              | and_expr "and" not_expr -> and_cond

?not_expr     : comparison
              | "not" not_expr -> not_cond

?comparison   : sum
              | sum "==" sum -> equ
              | sum "!=" sum -> nequ
              | sum ">=" sum -> gte
              | sum "<=" sum -> lte
              | sum ">"  sum -> gt
              | sum "<"  sum -> lt

?sum          : term
              | sum "+" term -> add_stmt
              | sum "-" term -> sub_stmt

?term         : unary
              | term "*" unary -> mul_stmt
              | term "/" unary -> div_stmt
              | term "%" unary -> mod_stmt

?unary        : postfix
              | "-" unary -> neg_stmt

?postfix      : atom
              | postfix "." NAME -> member_access
              | postfix "[" expr "]" -> index_access
              | postfix "(" [arg_list] ")" -> fn_call
              | postfix "::" NAME "(" [arg_list] ")" -> bound_method_call

?atom         : NUMBER
              | STRING
              | array
              | map
              | bool
              | "null" -> null_lit
              | "this" -> this_ref
              | new_expr
              | method_call
              | super_call
              | static_ref
              | lambda_fn
              | NAME
              | "(" expr ")"

// ── Classes (expressions) ──────────────────────────────────
new_expr     : "new" NAME "(" [arg_list] ")"
// `::Method()` — calls an instance method with the current `this`
method_call  : "::" NAME "(" [arg_list] ")"
// `super::Method()` — calls the parent implementation
super_call   : "super" "::" NAME "(" [arg_list] ")"
             | "super" "::" "constructor" "(" [arg_list] ")" -> super_constructor_call
// `.Method()` — calls a static method of the current class
static_ref   : "." NAME

arg_list     : expr ("," expr)*

// ── Ignored tokens ─────────────────────────────────────────
%ignore /[ \t\r\n]+/
%ignore COMMENT
