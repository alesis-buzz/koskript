// ── Terminals ──────────────────────────────────────────────
NAME      : /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER    : /[0-9]+(\.[0-9]+)?/
STRING    : /\"[^\"]*\"|\'[^\']*\'/
COMMENT   : /\/\/[^\n]*/
// Matches a bare `return` at the end of a line (or before a comment/EOF).
// Higher priority so it wins over the `return` keyword on equal length.
RETURN_VOID.2 : /return[ \t]*(?=\/\/|\n|$)/

array: "[" expr ("," expr)* "]"
bool: "true" -> bool_true
    | "false" -> bool_false

lambda_fn: "(" ")" block
         | "(" expr ("," expr)* ")" block -> lambda_fn_args

map_obj: expr ":" expr
map: "{" map_obj ("," map_obj)* "}"

// ── Entry point ────────────────────────────────────────────
?start        : statement*

// ── Statements ─────────────────────────────────────────────
?statement    : local_decl
            | fn_def
            | return_stmt
            | while_stmt
            | for_stmt
            | foritem_stmt
            | expr_stmt
            | decl
            | if_stmt

// ── Variable declaration ───────────────────────────────────
local_decl   : "local" NAME "=" expr
decl: NAME "=" expr

// ── Function definition ────────────────────────────────────
fn_def       : "fn" NAME "(" param_list ")" block
            | "fn" NAME "(" ")" block -> fn_def_nargs

param_list : NAME ("," NAME)*



// ── Return ─────────────────────────────────────────────────
return_stmt  : "return" expr? -> return_value
             | RETURN_VOID    -> return_void

// ── While ──────────────────────────────────────────────────
while_stmt   : "while" "(" expr ")" block

// ── For loops ──────────────────────────────────────────────
for_stmt     : "for" "(" NAME "in" expr ")" block
foritem_stmt : "foreach" "(" NAME "," NAME "in" expr ")" block

// ── If ─────────────────────────────────────────────────────

if_stmt: "if" "(" expr ")" block elseif_stmt* elsestmt?
elseif_stmt: "elseif" "(" expr ")" block
elsestmt: "else" block

// ── Block ──────────────────────────────────────────────────
block        : "{" statement* "}"

// ── Expressions ────────────────────────────────────────────
// Precedence, lowest to highest:
//   or  <  and  <  not  <  comparison  <  +/-  <  */  <  unary  <  atom
?expr_stmt    : expr

?expr         : or_expr

?or_expr      : and_expr
              | or_expr "or" and_expr -> or_cond

?and_expr     : not_expr
              | and_expr "and" not_expr -> and_cond

?not_expr     : comparison
              | "not" not_expr -> not_cond

?comparison   : sum
              | sum "==" sum -> equ
              | sum "!=" sum -> nequ
              | sum ">=" sum -> gte
              | sum "<=" sum -> lte
              | sum ">"  sum -> gt
              | sum "<"  sum -> lt

?sum          : term
              | sum "+" term -> add_stmt
              | sum "-" term -> sub_stmt

?term         : unary
              | term "*" unary -> mul_stmt
              | term "/" unary -> div_stmt

?unary        : atom
              | "-" unary -> neg_stmt

?atom         : fn_call
              | NUMBER
              | STRING
              | array
              | map
              | member_access
              | bool
              | lambda_fn
              | "(" expr ")"

// ── Function call ──────────────────────────────────────────
fn_call      : member_access "(" arg_list? ")"
member_access: NAME ("." NAME)*
arg_list     : expr ("," expr)*

// ── Ignored tokens ─────────────────────────────────────────
%ignore /[ \t\r\n]+/
%ignore COMMENT
