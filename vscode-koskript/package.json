{
  "name": "koskript",
  "displayName": "Koskript",
  "description": "Syntax highlighting for the Koskript language",
  "version": "1.5.0",
  "publisher": "alesis-buzz",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:koskript"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "koskript",
        "aliases": [
          "Koskript",
          "kos"
        ],
        "extensions": [
          ".kos",
          ".kosh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "koskript",
        "scopeName": "source.koskript",
        "path": "./syntaxes/koskript.tmLanguage.json"
      }
    ]
  }
}